<w:document xmlns:wpc="http://schemas.microsoft.com/office/word/2010/wordprocessingCanvas" xmlns:cx="http://schemas.microsoft.com/office/drawing/2014/chartex" xmlns:cx1="http://schemas.microsoft.com/office/drawing/2015/9/8/chartex" xmlns:cx2="http://schemas.microsoft.com/office/drawing/2015/10/21/chartex" xmlns:cx3="http://schemas.microsoft.com/office/drawing/2016/5/9/chartex" xmlns:cx4="http://schemas.microsoft.com/office/drawing/2016/5/10/chartex" xmlns:cx5="http://schemas.microsoft.com/office/drawing/2016/5/11/chartex" xmlns:cx6="http://schemas.microsoft.com/office/drawing/2016/5/12/chartex" xmlns:cx7="http://schemas.microsoft.com/office/drawing/2016/5/13/chartex" xmlns:cx8="http://schemas.microsoft.com/office/drawing/2016/5/14/chartex" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:aink="http://schemas.microsoft.com/office/drawing/2016/ink" xmlns:am3d="http://schemas.microsoft.com/office/drawing/2017/model3d" xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:oel="http://schemas.microsoft.com/office/2019/extlst" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" xmlns:m="http://schemas.openxmlformats.org/officeDocument/2006/math" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:wp14="http://schemas.microsoft.com/office/word/2010/wordprocessingDrawing" xmlns:wp="http://schemas.openxmlformats.org/drawingml/2006/wordprocessingDrawing" xmlns:w10="urn:schemas-microsoft-com:office:word" xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:w14="http://schemas.microsoft.com/office/word/2010/wordml" xmlns:w15="http://schemas.microsoft.com/office/word/2012/wordml" xmlns:w16cex="http://schemas.microsoft.com/office/word/2018/wordml/cex" xmlns:w16cid="http://schemas.microsoft.com/office/word/2016/wordml/cid" xmlns:w16="http://schemas.microsoft.com/office/word/2018/wordml" xmlns:w16du="http://schemas.microsoft.com/office/word/2023/wordml/word16du" xmlns:w16sdtdh="http://schemas.microsoft.com/office/word/2020/wordml/sdtdatahash" xmlns:w16sdtfl="http://schemas.microsoft.com/office/word/2024/wordml/sdtformatlock" xmlns:w16se="http://schemas.microsoft.com/office/word/2015/wordml/symex" xmlns:wpg="http://schemas.microsoft.com/office/word/2010/wordprocessingGroup" xmlns:wpi="http://schemas.microsoft.com/office/word/2010/wordprocessingInk" xmlns:wne="http://schemas.microsoft.com/office/word/2006/wordml" xmlns:wps="http://schemas.microsoft.com/office/word/2010/wordprocessingShape" mc:Ignorable="w14 w15 w16se w16cid w16 w16cex w16sdtdh w16sdtfl w16du wp14"><w:body><w:p w14:paraId="57E81A85" w14:textId="7415CD67" w:rsidR="0040580F" w:rsidRDefault="004951C5"><w:r><w:t>Proposal</w:t></w:r></w:p><w:p w14:paraId="32EB4823" w14:textId="652AE7F2" w:rsidR="004951C5" w:rsidRDefault="004951C5"><w:r><w:t>Our project initially set out to find the relationship between different variables and unemployment. This being our first project, we did not know what we were getting ourselves into. While our team had ideas of what visuals to display, I struggled to find an answer to the “So what” about our project.</w:t></w:r></w:p><w:p w14:paraId="6C841DF2" w14:textId="2485B11C" w:rsidR="004951C5" w:rsidRDefault="004951C5"><w:r><w:rPr><w:noProof/></w:rPr><w:drawing><wp:inline distT="0" distB="0" distL="0" distR="0" wp14:anchorId="1D09C900" wp14:editId="17CC139F"><wp:extent cx="5381625" cy="5567699"/><wp:effectExtent l="0" t="0" r="0" b="0"/><wp:docPr id="1582136335" name="Picture 1"/><wp:cNvGraphicFramePr><a:graphicFrameLocks xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" noChangeAspect="1"/></wp:cNvGraphicFramePr><a:graphic xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:pic xmlns:pic="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:nvPicPr><pic:cNvPr id="0" name="Picture 1"/><pic:cNvPicPr><a:picLocks noChangeAspect="1" noChangeArrowheads="1"/></pic:cNvPicPr></pic:nvPicPr><pic:blipFill><a:blip r:embed="rId5" cstate="print"><a:extLst><a:ext uri="{28A0092B-C50C-407E-A947-70E740481C1C}"><a14:useLocalDpi xmlns:a14="http://schemas.microsoft.com/office/drawing/2010/main" val="0"/></a:ext></a:extLst></a:blip><a:srcRect/><a:stretch><a:fillRect/></a:stretch></pic:blipFill><pic:spPr bwMode="auto"><a:xfrm><a:off x="0" y="0"/><a:ext cx="5399073" cy="5585750"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:noFill/><a:ln><a:noFill/></a:ln></pic:spPr></pic:pic></a:graphicData></a:graphic></wp:inline></w:drawing></w:r></w:p><w:p w14:paraId="54C587C2" w14:textId="7389691E" w:rsidR="004951C5" w:rsidRDefault="004951C5"><w:r><w:t>(Initial Project Designs)</w:t></w:r></w:p><w:p w14:paraId="1D843E9E" w14:textId="41835CEB" w:rsidR="004951C5" w:rsidRDefault="004951C5"><w:r><w:t>Evolution</w:t></w:r></w:p><w:p w14:paraId="3BA918DA" w14:textId="1DA02349" w:rsidR="004951C5" w:rsidRDefault="004951C5"><w:r><w:t>At the start of the project, we had three datasets in mind:</w:t></w:r></w:p><w:p w14:paraId="0E3D3DEF" w14:textId="1A1E4F12" w:rsidR="004951C5" w:rsidRDefault="004951C5" w:rsidP="004951C5"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr></w:pPr><w:r><w:t>City of New York Job Postings (NYC Open Data)</w:t></w:r></w:p><w:p w14:paraId="4F947D7B" w14:textId="0AB1F931" w:rsidR="004951C5" w:rsidRDefault="004951C5" w:rsidP="004951C5"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr></w:pPr><w:r><w:lastRenderedPageBreak/><w:t>United States Department of Labor Unemployment Claims (FRED)</w:t></w:r></w:p><w:p w14:paraId="7DE06676" w14:textId="5EDA8E0A" w:rsidR="004951C5" w:rsidRDefault="004951C5" w:rsidP="004951C5"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr></w:pPr><w:r><w:t>City of New York Mot</w:t></w:r><w:r w:rsidR="00410E53"><w:t>o</w:t></w:r><w:r><w:t>r Vehic</w:t></w:r><w:r w:rsidR="00410E53"><w:t xml:space="preserve">le Collisions – Crashes (NYC </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidR="00410E53"><w:t>OpenData</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidR="00410E53"><w:t>)</w:t></w:r></w:p><w:p w14:paraId="4322DD02" w14:textId="1933FF0D" w:rsidR="00410E53" w:rsidRDefault="00410E53" w:rsidP="00410E53"><w:r><w:t xml:space="preserve">Coming from a finance background, I had always expected excel sheets to have useful numbers that could be analyzed and turned into meaningful information. However, when I investigated City of New York Motor Vehicle Collisions, there were no numbers that I could analyze that would produce something meaningful with our dashboard. </w:t></w:r></w:p><w:p w14:paraId="7FFE3BAA" w14:textId="5D8908DF" w:rsidR="00410E53" w:rsidRDefault="00410E53" w:rsidP="00410E53"><w:r><w:tab/><w:t xml:space="preserve">Furthermore, when looking into city of New York Job Postings, we learned that the sheet was updated regularly to where a job was filled, they would remove it from that dataset. This meant that while the dataset was in real time, we could not get the historical information on jobs </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:t>ie</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:t xml:space="preserve">. </w:t></w:r><w:proofErr w:type="gramStart"/><w:r><w:t>it</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r><w:t xml:space="preserve"> was impossible to calculate yearly numbers that would have been useful with our dashboard. Although there was an opportunity to query and create our own dataset of historical job postings, it did not make sense given our three-month period. Ultimately, we decided to drop this dataset as well.</w:t></w:r></w:p><w:p w14:paraId="6CAEB6FA" w14:textId="5CFD26D6" w:rsidR="00410E53" w:rsidRDefault="00410E53" w:rsidP="00410E53"><w:r><w:tab/><w:t>This meant that out of our three initial datasets, we only had one that was useable. Going back to the drawing board, Sophia and I went back to the drawing board to figure out what to do. Eventually we decided that she would focus on health data and its relation to unemployment, and I would focus on unemployment and its relation to evictions. This led me to go on a deep dive into unemployment for New York City as a whole.</w:t></w:r></w:p><w:p w14:paraId="6C4B9C19" w14:textId="7F811295" w:rsidR="00410E53" w:rsidRDefault="00410E53" w:rsidP="00410E53"><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:tab/></w:r><w:r w:rsidR="005142CA"><w:t>One bold assumption I had was everything was readily available on the internet. Turns out, there is not a lot of information! I had originally used the U.S. Bureau of Labor Statistics unemployment rate for New York State to create analysis between our variables</w:t></w:r></w:p><w:p w14:paraId="6F6D072E" w14:textId="77777777" w:rsidR="005142CA" w:rsidRDefault="005142CA" w:rsidP="00410E53"><w:r w:rsidRPr="005142CA"><w:drawing><wp:inline distT="0" distB="0" distL="0" distR="0" wp14:anchorId="27C201B5" wp14:editId="0C748D04"><wp:extent cx="5943600" cy="2889885"/><wp:effectExtent l="0" t="0" r="0" b="5715"/><wp:docPr id="1636089148" name="Picture 1"/><wp:cNvGraphicFramePr><a:graphicFrameLocks xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" noChangeAspect="1"/></wp:cNvGraphicFramePr><a:graphic xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:pic xmlns:pic="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:nvPicPr><pic:cNvPr id="1636089148" name=""/><pic:cNvPicPr/></pic:nvPicPr><pic:blipFill><a:blip r:embed="rId6"/><a:stretch><a:fillRect/></a:stretch></pic:blipFill><pic:spPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="5943600" cy="2889885"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></pic:spPr></pic:pic></a:graphicData></a:graphic></wp:inline></w:drawing></w:r></w:p><w:p w14:paraId="2887FAAF" w14:textId="77777777" w:rsidR="005142CA" w:rsidRDefault="005142CA" w:rsidP="00410E53"><w:r><w:lastRenderedPageBreak/><w:tab/><w:t>While this certainly did work when it came to unemployment and claims, with the above picture showing a rather strong correlation, we ran into issues on our main dashboard, where we were trying to match the actual numbers as close as possible to New York City’s actual unemployment rate.</w:t></w:r></w:p><w:p w14:paraId="5CA799F6" w14:textId="279C0EDD" w:rsidR="00410E53" w:rsidRDefault="005142CA" w:rsidP="00410E53"><w:r><w:tab/><w:t>What I had to do instead was go through each individual borough’s unemployment data, to create an aggregate sum to be used in our analysis.</w:t></w:r></w:p><w:p w14:paraId="0D83498B" w14:textId="3C443EBA" w:rsidR="005142CA" w:rsidRDefault="005142CA" w:rsidP="00410E53"><w:r w:rsidRPr="005142CA"><w:drawing><wp:inline distT="0" distB="0" distL="0" distR="0" wp14:anchorId="21272B68" wp14:editId="76B8F358"><wp:extent cx="4029637" cy="1771897"/><wp:effectExtent l="0" t="0" r="9525" b="0"/><wp:docPr id="216096185" name="Picture 1"/><wp:cNvGraphicFramePr><a:graphicFrameLocks xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" noChangeAspect="1"/></wp:cNvGraphicFramePr><a:graphic xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:pic xmlns:pic="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:nvPicPr><pic:cNvPr id="216096185" name=""/><pic:cNvPicPr/></pic:nvPicPr><pic:blipFill><a:blip r:embed="rId7"/><a:stretch><a:fillRect/></a:stretch></pic:blipFill><pic:spPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="4029637" cy="1771897"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></pic:spPr></pic:pic></a:graphicData></a:graphic></wp:inline></w:drawing></w:r></w:p><w:p w14:paraId="646EDAA9" w14:textId="5F174831" w:rsidR="005142CA" w:rsidRDefault="005142CA" w:rsidP="00410E53"><w:r><w:t>(Actual)</w:t></w:r></w:p><w:p w14:paraId="043902D9" w14:textId="5658DFBC" w:rsidR="005142CA" w:rsidRDefault="005142CA" w:rsidP="00410E53"><w:r w:rsidRPr="005142CA"><w:drawing><wp:inline distT="0" distB="0" distL="0" distR="0" wp14:anchorId="2A8C095D" wp14:editId="594FF4FF"><wp:extent cx="5468113" cy="2010056"/><wp:effectExtent l="0" t="0" r="0" b="9525"/><wp:docPr id="1325039538" name="Picture 1"/><wp:cNvGraphicFramePr><a:graphicFrameLocks xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" noChangeAspect="1"/></wp:cNvGraphicFramePr><a:graphic xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:pic xmlns:pic="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:nvPicPr><pic:cNvPr id="1325039538" name=""/><pic:cNvPicPr/></pic:nvPicPr><pic:blipFill><a:blip r:embed="rId8"/><a:stretch><a:fillRect/></a:stretch></pic:blipFill><pic:spPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="5468113" cy="2010056"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></pic:spPr></pic:pic></a:graphicData></a:graphic></wp:inline></w:drawing></w:r></w:p><w:p w14:paraId="47CAB1E4" w14:textId="51C12229" w:rsidR="005142CA" w:rsidRDefault="005142CA" w:rsidP="00410E53"><w:r><w:t>(Our Projections)</w:t></w:r></w:p><w:p w14:paraId="266386CE" w14:textId="6E6818E5" w:rsidR="005142CA" w:rsidRDefault="005142CA" w:rsidP="00410E53"><w:r><w:t xml:space="preserve">By using the eviction share percentage and multiplying it by the total unemployed calculated using the five-borough information, we were able to get relatively close to the actual numbers </w:t></w:r><w:r w:rsidR="00B65D8D"><w:t>minus the Bronx and Manhattan.</w:t></w:r></w:p><w:p w14:paraId="72EA97AE" w14:textId="05F9AD5D" w:rsidR="00B65D8D" w:rsidRDefault="00B65D8D" w:rsidP="00410E53"><w:r><w:t xml:space="preserve">When taking a deeper look into these two boroughs we </w:t></w:r><w:proofErr w:type="gramStart"/><w:r><w:t>came to the conclusion</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r><w:t xml:space="preserve"> that because the Bronx is typically associated with lower class individuals, and Manhattan is associated with higher class individuals, there may be other socioeconomic factors that may affect people getting evicted other than unemployment. </w:t></w:r></w:p><w:p w14:paraId="621F11E0" w14:textId="77777777" w:rsidR="004951C5" w:rsidRDefault="004951C5"/><w:p w14:paraId="2B8DE465" w14:textId="12DAF119" w:rsidR="004951C5" w:rsidRDefault="004951C5"><w:r><w:lastRenderedPageBreak/><w:t>Code</w:t></w:r></w:p><w:p w14:paraId="7EDD9D59" w14:textId="762C8D25" w:rsidR="00B65D8D" w:rsidRDefault="00B65D8D"><w:r><w:tab/><w:t xml:space="preserve">Much of our code </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:t>plotly</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:t xml:space="preserve"> as displays for our visualization. For the more difficult and interactive dashboard, I spent time looking through </w:t></w:r><w:proofErr w:type="gramStart"/><w:r><w:t>the documentation</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r><w:t xml:space="preserve"> on how to create a hexagon layer map. </w:t></w:r></w:p><w:p w14:paraId="0DE04A6C" w14:textId="26F27F8B" w:rsidR="00B65D8D" w:rsidRDefault="00B65D8D"><w:r w:rsidRPr="00B65D8D"><w:drawing><wp:inline distT="0" distB="0" distL="0" distR="0" wp14:anchorId="4013B743" wp14:editId="70E0F62E"><wp:extent cx="5943600" cy="2775585"/><wp:effectExtent l="0" t="0" r="0" b="5715"/><wp:docPr id="213293571" name="Picture 1"/><wp:cNvGraphicFramePr><a:graphicFrameLocks xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" noChangeAspect="1"/></wp:cNvGraphicFramePr><a:graphic xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:pic xmlns:pic="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:nvPicPr><pic:cNvPr id="213293571" name=""/><pic:cNvPicPr/></pic:nvPicPr><pic:blipFill><a:blip r:embed="rId9"/><a:stretch><a:fillRect/></a:stretch></pic:blipFill><pic:spPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="5943600" cy="2775585"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></pic:spPr></pic:pic></a:graphicData></a:graphic></wp:inline></w:drawing></w:r></w:p><w:p w14:paraId="595F9A40" w14:textId="253A32B7" w:rsidR="00B65D8D" w:rsidRDefault="00B65D8D"><w:r><w:t>(Creating Layers)</w:t></w:r></w:p><w:p w14:paraId="20DAD24C" w14:textId="15152980" w:rsidR="00B65D8D" w:rsidRDefault="00B65D8D"><w:r w:rsidRPr="00B65D8D"><w:drawing><wp:inline distT="0" distB="0" distL="0" distR="0" wp14:anchorId="67E5C327" wp14:editId="735121F2"><wp:extent cx="5943600" cy="3402330"/><wp:effectExtent l="0" t="0" r="0" b="7620"/><wp:docPr id="47316604" name="Picture 1"/><wp:cNvGraphicFramePr><a:graphicFrameLocks xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" noChangeAspect="1"/></wp:cNvGraphicFramePr><a:graphic xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:pic xmlns:pic="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:nvPicPr><pic:cNvPr id="47316604" name=""/><pic:cNvPicPr/></pic:nvPicPr><pic:blipFill><a:blip r:embed="rId10"/><a:stretch><a:fillRect/></a:stretch></pic:blipFill><pic:spPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="5943600" cy="3402330"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></pic:spPr></pic:pic></a:graphicData></a:graphic></wp:inline></w:drawing></w:r></w:p><w:p w14:paraId="6DFFA1E8" w14:textId="5F7D742E" w:rsidR="00B65D8D" w:rsidRDefault="00B65D8D"><w:r><w:t>(Creating Map)</w:t></w:r></w:p><w:p w14:paraId="048EE26C" w14:textId="4CE51746" w:rsidR="00B65D8D" w:rsidRDefault="00B65D8D"><w:r><w:lastRenderedPageBreak/><w:tab/><w:t>By creating these two different codes, I was able to get a sophisticated display that was both interactive and visually appealing.</w:t></w:r></w:p><w:p w14:paraId="273706DF" w14:textId="0D921F33" w:rsidR="00B65D8D" w:rsidRDefault="00B65D8D"><w:r w:rsidRPr="00B65D8D"><w:drawing><wp:inline distT="0" distB="0" distL="0" distR="0" wp14:anchorId="39C390AA" wp14:editId="11D51FD8"><wp:extent cx="5943600" cy="2074545"/><wp:effectExtent l="0" t="0" r="0" b="1905"/><wp:docPr id="1399082297" name="Picture 1"/><wp:cNvGraphicFramePr><a:graphicFrameLocks xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" noChangeAspect="1"/></wp:cNvGraphicFramePr><a:graphic xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:pic xmlns:pic="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:nvPicPr><pic:cNvPr id="1399082297" name=""/><pic:cNvPicPr/></pic:nvPicPr><pic:blipFill><a:blip r:embed="rId11"/><a:stretch><a:fillRect/></a:stretch></pic:blipFill><pic:spPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="5943600" cy="2074545"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></pic:spPr></pic:pic></a:graphicData></a:graphic></wp:inline></w:drawing></w:r></w:p><w:p w14:paraId="59E59BD1" w14:textId="6BCB5EE2" w:rsidR="00B65D8D" w:rsidRDefault="00B65D8D"><w:r><w:tab/><w:t xml:space="preserve">Another integral part of the project was </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:t>bigquery</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:t xml:space="preserve">. As mentioned before, there was nowhere that actual had averages of New York City unemployment. I am hoping that moving forward, we can provide a historical database of the </w:t></w:r><w:proofErr w:type="gramStart"/><w:r><w:t>averages, and</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r><w:t xml:space="preserve"> eventually get it closer to match the actual numbers. </w:t></w:r></w:p><w:p w14:paraId="5831A126" w14:textId="61BA6CEF" w:rsidR="00B65D8D" w:rsidRDefault="00B65D8D"><w:r w:rsidRPr="00B65D8D"><w:drawing><wp:inline distT="0" distB="0" distL="0" distR="0" wp14:anchorId="47F1E6BD" wp14:editId="57A59B4B"><wp:extent cx="5943600" cy="3241040"/><wp:effectExtent l="0" t="0" r="0" b="0"/><wp:docPr id="157159571" name="Picture 1"/><wp:cNvGraphicFramePr><a:graphicFrameLocks xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" noChangeAspect="1"/></wp:cNvGraphicFramePr><a:graphic xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:pic xmlns:pic="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:nvPicPr><pic:cNvPr id="157159571" name=""/><pic:cNvPicPr/></pic:nvPicPr><pic:blipFill><a:blip r:embed="rId12"/><a:stretch><a:fillRect/></a:stretch></pic:blipFill><pic:spPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="5943600" cy="3241040"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></pic:spPr></pic:pic></a:graphicData></a:graphic></wp:inline></w:drawing></w:r></w:p><w:p w14:paraId="41063C46" w14:textId="32460858" w:rsidR="00B65D8D" w:rsidRDefault="00B65D8D"><w:r><w:t>(Example of eviction query)</w:t></w:r></w:p><w:p w14:paraId="23DB971B" w14:textId="0DD91146" w:rsidR="004951C5" w:rsidRDefault="004951C5"><w:r><w:t>Learnings</w:t></w:r></w:p><w:p w14:paraId="72888A26" w14:textId="04465D30" w:rsidR="00B65D8D" w:rsidRDefault="00B65D8D"><w:r><w:tab/></w:r><w:r w:rsidR="0061279A"><w:t xml:space="preserve">My biggest takeaway from the project is that we can always find a “so what” in data. I remember constantly pestering Sneha about finding meaningful information in a world </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidR="0061279A"><w:lastRenderedPageBreak/><w:t>were</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidR="0061279A"><w:t xml:space="preserve"> information is so readily available, but throughout the project I found holes in the vast internet that our project could fill. </w:t></w:r></w:p><w:p w14:paraId="1349DCCA" w14:textId="02EC14B2" w:rsidR="0061279A" w:rsidRDefault="0061279A"><w:r><w:tab/><w:t xml:space="preserve">Some smaller takeaways </w:t></w:r><w:proofErr w:type="gramStart"/><w:r><w:t>was</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r><w:t xml:space="preserve"> just learning how to work with </w:t></w:r><w:proofErr w:type="gramStart"/><w:r><w:t>people as a whole</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r><w:t xml:space="preserve">. I have always been an advocate of doing things myself, but this project was simply impossible to do alone. Understanding the intricacies of </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:t>Github</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:t xml:space="preserve"> (and merge conflicts!) really made me understand and appreciate collaboration as a whole!</w:t></w:r></w:p><w:sectPr w:rsidR="0061279A"><w:pgSz w:w="12240" w:h="15840"/><w:pgMar w:top="1440" w:right="1440" w:bottom="1440" w:left="1440" w:header="720" w:footer="720" w:gutter="0"/><w:cols w:space="720"/><w:docGrid w:linePitch="360"/></w:sectPr></w:body></w:document>